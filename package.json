{
  "name": "@mgcrea/mcp-unifi-protect",
  "version": "1.0.1",
  "description": "Model Context Protocol server for UniFi Protect",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "unifi-protect"
  ],
  "license": "MIT",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/mcp-unifi-protect.git"
  },
  "bin": {
    "unifi-protect-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "npm version --message \"release: cut the v%s release\"",
    "docker:build": "BUILDER=build scripts/docker-build.sh",
    "docker:buildx": "BUILDER=buildx scripts/docker-build.sh",
    "docker:push": "docker push mgcrea/mcp-unifi-protect:latest && docker push mgcrea/mcp-unifi-protect:$npm_package_version",
    "docker:release": "BUILDER=buildx scripts/docker-build.sh --push",
    "prepublishOnly": "pnpm run check:deps && pnpm build",
    "check:deps": "node -e \"const d=require('./package.json').dependencies;const bad=Object.entries(d).filter(([,v])=>/^(link|file|workspace):/.test(v));if(bad.length){console.error('Refusing to publish: '+bad.map(([k,v])=>k+'@'+v).join(', ')+' resolves to a local path and would not install for anyone else.');process.exit(1)}\""
  },
  "dependencies": {
    "@mgcrea/unifi-protect": "^0.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.1"
}
